# Copy to .env. Every setting is optional; the defaults run fully offline.

# Agents: "offline" (scripted, no AWS) or "bedrock" (a model in Amazon Bedrock)
OPSRELAY_MODEL_PROVIDER=offline
# Amazon Nova by default. For Claude (needs an AWS Marketplace subscription): global.anthropic.claude-opus-5
OPSRELAY_BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0
OPSRELAY_AWS_REGION=us-east-1

# Let low-risk actions run without a person: none | low | medium
OPSRELAY_AUTO_APPROVE_RISK=none

# AWS credentials for Bedrock when running in Docker (or use an AWS profile locally)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
