# Copy to .env. Every setting is optional; the defaults run fully offline.

# Agents: "offline" (scripted, no AWS) or "bedrock" (Claude through Amazon Bedrock)
AGENTMESH_MODEL_PROVIDER=offline
AGENTMESH_BEDROCK_MODEL_ID=global.anthropic.claude-opus-5
AGENTMESH_AWS_REGION=us-east-1

# Let low-risk actions run without a person: none | low | medium
AGENTMESH_AUTO_APPROVE_RISK=none

# AWS credentials for Bedrock when running in Docker (or use an AWS profile locally)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
